{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@minecraft/server": ["./node_modules/@minecraft/server/index.d.ts"]
    }
  },
  "include": [
    "../../mods/*/bedrock/behavior_pack/scripts/**/*.js",
    "../../scripts/fixtures/*-bedrock-smoke.js"
  ]
}
