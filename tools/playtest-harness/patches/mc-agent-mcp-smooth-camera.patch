+		// This loop runs on the HTTP thread. Yield between small rotations so
+		// the game can render the turn and continue ticking the world.
+		for (int i = 0; i < MAX_TURN_TICKS; i++) {
+			JsonObject result = bridge.callOnGameThread(() -> turnToward(destination));
+			if (result != null) return result;
+			try {
+				Thread.sleep(50);
+			} catch (InterruptedException e) {
+				Thread.currentThread().interrupt();
+				throw new ToolException("turn was interrupted");
+			}
+		}
+		throw new ToolException("view changed before the turn settled");
+	}
