+	private static JsonObject turnToward(View target) {
+		LocalPlayer p = GameBridge.requirePlayer();
+		float yawError = Mth.wrapDegrees(target.yaw() - p.getYRot());
+		float pitchError = target.pitch() - p.getXRot();
+		p.setYRot(p.getYRot() + Mth.clamp(yawError, -YAW_STEP, YAW_STEP));
+		p.setYHeadRot(p.getYRot());
+		p.setXRot(p.getXRot() + Mth.clamp(pitchError, -PITCH_STEP, PITCH_STEP));
+		if (Math.abs(yawError) > YAW_STEP || Math.abs(pitchError) > PITCH_STEP) return null;
+		JsonObject result = new JsonObject();
+		result.addProperty("yaw", Json.round2(p.getYRot()));
+		result.addProperty("pitch", Json.round2(p.getXRot()));
+		return result;
