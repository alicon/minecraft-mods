{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.mushroom_yorkie": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ],
      "part_visibility": [
        {
          "harness": "query.property('mushroom_yorkie:wearing_harness')"
        },
        {
          "vest": "query.property('mushroom_yorkie:vest_kind') != 'none'"
        },
        {
          "scute_plates": "query.property('mushroom_yorkie:vest_kind') == 'plated'"
        },
        {
          "vest_cracks": "query.property('mushroom_yorkie:vest_cracked')"
        },
        {
          "left_eye": "!(query.property('mushroom_yorkie:home_goal') == 'sleep')"
        },
        {
          "right_eye": "!(query.property('mushroom_yorkie:home_goal') == 'sleep')"
        }
      ]
    }
  }
}
