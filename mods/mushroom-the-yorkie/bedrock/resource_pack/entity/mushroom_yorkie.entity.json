{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "mushroom_yorkie:mushroom_yorkie",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/alicon/mushroom_yorkie/entity/mushroom_yorkie"
      },
      "geometry": {
        "default": "geometry.mushroom_yorkie.yorkie"
      },
      "spawn_egg": {
        "base_color": "#614738",
        "overlay_color": "#DAB181"
      },
      "animations": {
        "look": "animation.mushroom_yorkie.look",
        "idle": "animation.mushroom_yorkie.idle",
        "walk": "animation.mushroom_yorkie.walk",
        "sit": "animation.mushroom_yorkie.sit",
        "sleep": "animation.mushroom_yorkie.sleep",
        "flight": "animation.mushroom_yorkie.flight"
      },
      "scripts": {
        "animate": [
          {
            "look": "!(query.property('mushroom_yorkie:home_goal') == 'sleep')"
          },
          {
            "idle": "!(query.property('mushroom_yorkie:home_goal') == 'sleep') && !query.is_sitting && query.property('mushroom_yorkie:flight_mode') == 'ground'"
          },
          {
            "walk": "!(query.property('mushroom_yorkie:home_goal') == 'sleep') && !query.is_sitting && query.modified_move_speed > 0.01 && query.property('mushroom_yorkie:flight_mode') == 'ground'"
          },
          {
            "sit": "!(query.property('mushroom_yorkie:home_goal') == 'sleep') && query.is_sitting && query.property('mushroom_yorkie:flight_mode') == 'ground'"
          },
          {
            "sleep": "query.property('mushroom_yorkie:home_goal') == 'sleep'"
          },
          {
            "flight": "query.property('mushroom_yorkie:flight_mode') != 'ground'"
          }
        ]
      },
      "render_controllers": [
        "controller.render.mushroom_yorkie"
      ]
    }
  }
}
